# App
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me
AUTH_SECRET=change_me
AUTH_URL=http://localhost:3000
BCRYPT_ROUNDS=12

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/justwriteit

# Audio storage and source allowlist
BLOB_READ_WRITE_TOKEN=
ALLOWED_AUDIO_SOURCE_HOSTS=

# Whisper service (server-side only)
WHISPER_SERVICE_URL=http://localhost:8000
WHISPER_SERVICE_TOKEN=change_me
WHISPER_MAX_AUDIO_FILE_SIZE_MB=100

# Email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
